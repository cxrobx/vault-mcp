<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- For a machine with `indexing = false`: every 15 minutes, take the laptop's
     index if it changed. A sleeping laptop just means no copy this run. Paths
     are the Mac mini's. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cx.vault-index-pull</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/cx/Projects/vault-mcp/.venv/bin/python</string>
        <string>/Users/cx/Projects/vault-mcp/scripts/pull_index.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/cx/Projects/vault-mcp</string>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/cx/Library/Logs/vault-index-pull.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cx/Library/Logs/vault-index-pull.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
